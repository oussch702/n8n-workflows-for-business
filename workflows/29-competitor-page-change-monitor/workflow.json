          "combinator": "and"
        },
        "options": {}
      },
      "id": "ea45ad8b-1e89-4e90-a740-66a258f353df",
      "name": "Changed since last run?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1100,
        420
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You monitor a competitor's web page for a small business owner.\nCompetitor: {{ $json.name }}\nPage: {{ $json.url }}\n\nLines that disappeared since yesterday:\n{{ $json.removed || '(none)' }}\n\nLines that are new today:\n{{ $json.added || '(none)' }}\n\nExplain what changed in 1 to 4 short bullet points that start with \"- \". Lead with prices, plans, offers, guarantees, features and positioning. Quote old and new values when you can (for example \"Pro plan: $49 to $59 per month\").\nIf the only differences are dates, counters, rotating testimonials, cookie banners or other noise, reply with exactly NO_MEANINGFUL_CHANGE and nothing else.",
        "batching": {}
      },
      "id": "d3aeff55-a4a8-4922-a2a3-0267a61a5a10",
      "name": "Summarize what changed",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1320,
        420
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4.1-mini",
          "cachedResultName": "gpt-4.1-mini"
        },
        "options": {
          "temperature": 0.2
        }
      },
      "id": "5bbc7a06-911d-4fd4-a166-2f411947a63f",
      "name": "OpenAI model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        1320,
        640
