            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "meaningful",
              "leftValue": "={{ $json.text }}",
              "rightValue": "NO_MEANINGFUL_CHANGE",
              "operator": {
                "type": "string",
                "operation": "notContains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b3d9928d-29a7-4577-acc5-b586b4bad504",
      "name": "Skip cosmetic changes",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
