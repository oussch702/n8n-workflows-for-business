      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "YOUR_SLACK_CHANNEL_ID",
          "mode": "id"
        },
        "text": "=*High-scoring call: {{ $('Calculate the lead score').item.json.lead_score }}/100*\n*Who:* {{ $('Calculate the lead score').item.json.name || 'Unknown' }} {{ $('Calculate the lead score').item.json.email }} {{ $('Calculate the lead score').item.json.phone }}\n*Budget:* {{ $('Calculate the lead score').item.json.budget || 'not discussed' }}  *Timeline:* {{ $('Calculate the lead score').item.json.timeline || 'not discussed' }}\n*Summary:* {{ $('Calculate the lead score').item.json.summary }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
