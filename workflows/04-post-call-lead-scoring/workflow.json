    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "f74e569a-9cda-5986-a16a-e069f3674dd4",
              "leftValue": "={{ $('Calculate the lead score').item.json.lead_score }}",
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "rightValue": 70
