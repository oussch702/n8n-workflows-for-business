        "height": 200,
        "width": 480,
        "color": 6
      },
      "id": "9cc52c67-56fd-572e-a824-32598cc33394",
      "name": "Edit me: folder and settings",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -60
      ]
    },
