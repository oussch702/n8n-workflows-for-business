                    "id": "787b952a-a845-5169-86eb-c9b9ce3b15e7",
                    "leftValue": "={{ $json.status_code }}",
                    "rightValue": "EXPIRED",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
