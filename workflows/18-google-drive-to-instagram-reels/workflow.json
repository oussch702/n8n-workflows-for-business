              "name": "max_mb",
              "value": "50",
              "type": "number"
            },
            {
              "id": "2795ee3a-c40d-576e-8b16-866ee8d4c012",
              "name": "hashtags",
              "value": "#yourbrand #smallbusiness",
              "type": "string"
