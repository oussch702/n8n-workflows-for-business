        "jsonBody": "={{ JSON.stringify({\n  media_type: 'REELS',\n  video_url: 'https://drive.google.com/uc?export=download&id=' + $('Settings').item.json.file_id,\n  caption: ($('Settings').item.json.caption + '\\n\\n' + $('Settings').item.json.hashtags).trim(),\n  share_to_feed: true\n}) }}",
        "options": {
          "timeout": 60000
        }
