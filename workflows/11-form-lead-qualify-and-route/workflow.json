      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=Next step: pick a time that suits you, {{ $json.name.split(' ')[0] || 'there' }}",
        "emailType": "text",
        "message": "=Hi {{ $json.name.split(' ')[0] || 'there' }},\n\nThanks for reaching out about {{ $json.company || 'your project' }}. From what you shared, it sounds like we can help.\n\nThe quickest next step is a 20 minute call. Pick any slot that works for you here:\nhttps://cal.com/your-company/intro\n\nTalk soon,\nYour Name\nYour Company",
        "options": {
          "appendAttribution": false
        }
      },
