      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "6a907396-934c-573c-a313-9b27835b647f",
              "name": "name",
              "value": "={{ ($json.body.name || '').trim() }}",
              "type": "string"
            },
            {
              "id": "4f4707df-4945-5bbb-89e5-5c8171b272c5",
              "name": "email",
              "value": "={{ ($json.body.email || '').trim().toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "2f24daef-6ecc-5030-bb94-a99db22bbfc4",
              "name": "phone",
              "value": "={{ ($json.body.phone || '').trim() }}",
              "type": "string"
            },
            {
              "id": "2795ee3a-c40d-576e-8b16-866ee8d4c012",
              "name": "company",
              "value": "={{ ($json.body.company || '').trim() }}",
              "type": "string"
            },
            {
              "id": "34cf09b7-c81e-5c04-aa9d-fdf40dbaf3cf",
              "name": "budget",
              "value": "={{ Number(String($json.body.budget || 0).replace(/[^0-9.]/g, '')) || 0 }}",
              "type": "number"
            },
            {
              "id": "12bd6151-e54e-5bd8-853a-eef783db32e5",
              "name": "timeline",
              "value": "={{ String($json.body.timeline || '').trim().toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "cdd20d35-25a6-567a-8ae1-0a549a2d9ead",
              "name": "decision_maker",
              "value": "={{ ['yes', 'true', '1', 'on'].includes(String($json.body.decision_maker || '').trim().toLowerCase()) }}",
              "type": "boolean"
            },
            {
              "id": "8413545b-4c7a-5c79-bb42-cea8899a155f",
              "name": "message",
              "value": "={{ ($json.body.message || '').trim() }}",
              "type": "string"
