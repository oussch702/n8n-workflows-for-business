        "emailType": "text",
        "message": "=Hi {{ $('Settings').item.json.name || 'there' }},\n\nThank you for your visit today. We hope everything went well.\n\nIf you have a minute, a short Google review would mean a lot to us and helps other people find {{ $('Settings').item.json.business_name }}:\n{{ $('Settings').item.json.review_link }}\n\nAnd if anything was not right, just reply to this email. It comes straight to us.\n\nThanks,\nThe team at {{ $('Settings').item.json.business_name }}",
        "options": {
