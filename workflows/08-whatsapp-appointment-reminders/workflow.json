                    "type": "text",
                    "text": "={{ $json.firstName }}"
                  },
                  {
                    "type": "text",
                    "text": "={{ $json.dateText }}"
                  },
                  {
                    "type": "text",
                    "text": "={{ $json.timeText }}"
                  }
                ]
              }
            }
          ]
        }
      },
      "id": "b55a90c0-df13-555e-ae3b-c3234454baeb",
