                "operation": "gt"
              },
              "rightValue": 0
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "bdcbf3f4-4ea7-5c98-8aa9-e60c0ad56cb4",
      "name": "Any calls today?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Today is {{ $json.date }}. We took {{ $json.total }} calls: {{ $json.hot }} hot, {{ $json.warm }} warm, {{ $json.cold }} cold.\n\nCalls, one per line:\n{{ $json.callList }}",
        "messages": {
          "messageValues": [
            {
              "message": "You write the end-of-day call report for a small business owner. Plain text, no markdown, no greeting fluff. Structure: one line with the totals; then \"Call back first:\" with the hot leads (name, number, what they want, next step); then \"Worth a follow-up:\" for warm leads in one line each; then one line on anything unusual (complaints, repeated questions). Skip a section if it is empty. Under 200 words. Only use facts from the call list."
            }
          ]
        }
      },
