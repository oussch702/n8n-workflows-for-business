    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Keeps rows whose Date starts with today's date (workflow time zone) and counts them.\nconst today = $now.toFormat('yyyy-MM-dd');\nconst calls = $input.all()\n  .map((item) => item.json)\n  .filter((row) => String(row.Date ?? '').startsWith(today));\n\nconst count = (temp) => calls.filter((c) => String(c['Lead temperature'] ?? '').toLowerCase() === temp).length;\n\nconst lines = calls.map((c) => [\n  c.Date,\n  c['Caller name'] || 'Unknown caller',\n  c.From,\n  `temperature: ${c['Lead temperature'] || 'n/a'}`,\n  `reason: ${c.Reason || 'n/a'}`,\n  `summary: ${c.Summary || 'n/a'}`,\n  `next step: ${c['Next step'] || 'n/a'}`,\n].join(' | '));\n\nreturn [{\n  json: {\n    date: $now.toFormat('cccc d LLLL yyyy'),\n    total: calls.length,\n    hot: count('hot'),\n    warm: count('warm'),\n    cold: count('cold'),\n    callList: lines.join('\\n'),\n  },\n}];"
      },
      "id": "a876b2b4-8e30-533c-9f5a-01fc92467c85",
      "name": "Collect the calls from today",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "0c8d778e-b212-54a2-b3ed-7077ee04cbf8",
              "leftValue": "={{ $json.total }}",
              "operator": {
