    {
      "parameters": {
        "text": "=What we already know about this lead (may be empty):\nName: {{ $json.Name || '' }}\nNeed: {{ $json.Need || '' }}\nBudget: {{ $json.Budget || '' }}\nTiming: {{ $json.Timing || '' }}\n\nWhatsApp profile name: {{ $('WhatsApp Trigger').item.json.contacts?.[0]?.profile?.name || '' }}\nTheir new message:\n{{ $('WhatsApp Trigger').item.json.messages[0].text.body }}",
        "attributes": {
          "attributes": [
            {
              "name": "name",
              "description": "First name of the lead. Use what they wrote, else what we already know, else the WhatsApp profile name."
            },
            {
              "name": "need",
              "description": "What they want from us, under 12 words. Keep what we already know unless the new message changes it."
            },
            {
              "name": "budget",
              "description": "Their budget in their own words, for example \"around 5k\". Empty if never mentioned."
            },
            {
              "name": "budget_amount",
              "type": "number",
              "description": "Budget as a single number in US dollars (use the top of a range). 0 if unknown."
            },
            {
              "name": "timing",
              "description": "When they want to start, in their own words. Empty if never mentioned."
            },
            {
              "name": "timing_weeks",
              "type": "number",
              "description": "Weeks from today until they want to start (\"asap\" or \"this week\" = 1, \"next month\" = 4). 0 if unknown."
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "You keep a lead record up to date from a WhatsApp conversation. Merge what we already know with the new message. Never invent details. Leave unknown text fields empty."
        }
      },
