    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Edit these for your business.\nconst MIN_BUDGET = 1000;      // in US dollars\nconst MAX_WEEKS = 12;         // how soon they must want to start\nconst CALENDAR_LINK = 'https://example.com/book';\n\nconst msg = $('WhatsApp Trigger').item.json;\nconst prev = $('Find this lead in the sheet').item.json ?? {};\nconst ai = $json.output ?? {};\nconst pick = (fresh, old) => (fresh !== undefined && fresh !== null && String(fresh).trim() !== '' ? String(fresh).trim() : String(old ?? '').trim());\n\nconst lead = {\n  phone: '+' + msg.messages[0].from,\n  name: pick(ai.name, prev.Name),\n  need: pick(ai.need, prev.Need),\n  budget: pick(ai.budget, prev.Budget),\n  budgetAmount: Number(ai.budget_amount) || Number(prev['Budget (USD)']) || 0,\n  timing: pick(ai.timing, prev.Timing),\n  timingWeeks: Number(ai.timing_weeks) || Number(prev['Timing (weeks)']) || 0,\n  clickId: msg.messages[0].referral?.ctwa_clid || prev['Click ID'] || '',\n};\n\nconst hi = lead.name ? `Thanks ${lead.name}!` : 'Thanks!';\nlet status;\nlet reply;\n\nif (['qualified', 'not a fit'].includes(prev.Status)) {\n  // Already decided: leave the conversation to your team.\n  status = prev.Status;\n  reply = '';\n} else {\n  const missing = [];\n  if (!lead.need) missing.push('what you need help with');\n  if (!lead.budget) missing.push('your rough budget');\n  if (!lead.timing) missing.push('when you would like to start');\n\n  if (missing.length) {\n    status = 'collecting';\n    const list = missing.length === 1 ? missing[0] : missing.slice(0, -1).join(', ') + ' and ' + missing.at(-1);\n    reply = `${hi} So I can point you to the right person, could you tell me ${list}?`;\n  } else if (lead.budgetAmount >= MIN_BUDGET && lead.timingWeeks > 0 && lead.timingWeeks <= MAX_WEEKS) {\n    status = 'qualified';\n    reply = `${hi} That sounds like a good fit. Pick a time for a quick call here: ${CALENDAR_LINK}`;\n  } else {\n    status = 'not a fit';\n    reply = `${hi} Based on what you shared we might not be the best fit right now, but a member of the team will look at your message and get back to you.`;\n  }\n}\n\nreturn { json: { ...lead, status, reply, lastMessage: msg.messages[0].text.body } };"
      },
