      "parameters": {
        "method": "POST",
        "url": "https://searchconsole.googleapis.com/v1/urlInspection/index:inspect",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ inspectionUrl: $json.url, siteUrl: $('Your settings').first().json.siteUrl, languageCode: 'en-US' }) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 5,
              "batchInterval": 1000
            }
          },
          "timeout": 30000
        }
      },
      "id": "771c7535-82b1-4436-a212-e1a327393261",
      "name": "Inspect URL in Search Console",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        660,
        300
      ],
      "credentials": {
        "googleOAuth2Api": {
          "name": "Google Search Console account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Both of these coverage states mean \"in Google's index\".\nconst INDEXED = ['Submitted and indexed', 'Indexed, not submitted in sitemap'];\nconst now = new Date().toISOString();\n\nreturn $input.all().map((item, i) => {\n  const row = $('Read URLs to watch').itemMatching(i).json;\n  const result = item.json.inspectionResult || {};\n  const status = result.indexStatusResult || {};\n  const failed = Boolean(item.json.error) || !result.indexStatusResult;\n  const error = failed ? String(item.json.error?.message || item.json.error || 'No inspection result returned').slice(0, 200) : '';\n\n  const before = row.coverage_state || '';\n  // If the API call failed, keep yesterday's state so a hiccup never looks like a drop.\n  const coverageState = failed ? before : status.coverageState || 'Unknown';\n  const dropped = !failed && INDEXED.includes(before) && !INDEXED.includes(coverageState);\n\n  return {\n    json: {\n      url: row.url,\n      coverage_state: coverageState,\n      previous_state: before,\n      verdict: failed ? row.verdict || '' : status.verdict || '',\n      last_crawl: failed ? row.last_crawl || '' : status.lastCrawlTime || '',\n      google_canonical: failed ? row.google_canonical || '' : status.googleCanonical || '',\n      last_checked: now,\n      last_error: error,\n      inspection_link: result.inspectionResultLink || '',\n      dropped,\n    },\n  };\n});"
      },
      "id": "0a7e2d93-0aff-4a75-a572-cad2cc0a242e",
