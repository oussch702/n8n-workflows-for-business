          "conditions": [
            {
              "id": "ec6b9030-338d-5b5f-a88e-b2ce408049c9",
              "leftValue": "={{ $('Shape the call row').item.json['Lead temperature'] }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "hot"
