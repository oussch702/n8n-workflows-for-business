    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "YOUR_SLACK_CHANNEL_ID",
          "mode": "id"
        },
        "text": "=*Hot lead from a phone call*\n*Caller:* {{ $('Shape the call row').item.json['Caller name'] || 'Unknown' }} ({{ $('Shape the call row').item.json.From }})\n*Wants:* {{ $('Shape the call row').item.json.Reason }}\n*Summary:* {{ $('Shape the call row').item.json.Summary }}\n*Next step:* {{ $('Shape the call row').item.json['Next step'] }}",
        "otherOptions": {
