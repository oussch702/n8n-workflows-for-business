            "host": "={{ $('Build the IndexNow request').item.json.host }}",
            "url_count": "={{ $('Build the IndexNow request').item.json.urlList.length }}",
            "urls": "={{ $('Build the IndexNow request').item.json.urlList.join(' ') }}",
            "status": "={{ $json.statusCode || 'no response' }}",
            "meaning": "={{ ({ 200: 'OK, URLs submitted', 202: 'Accepted, key check pending', 400: 'Bad request, check the payload', 403: 'Key not valid, check the key file', 422: 'URLs do not belong to the host or key', 429: 'Too many requests, slow down' })[$json.statusCode] || ($json.error ? 'Request failed: ' + $json.error.message : 'Unexpected response') }}"
          },
