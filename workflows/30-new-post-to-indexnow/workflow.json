        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "df2e8152-2e2f-4aaa-a5b1-c64c46f654bc",
      "name": "Submit to IndexNow",
      "type": "n8n-nodes-base.httpRequest",
