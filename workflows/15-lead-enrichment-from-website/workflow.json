      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        880,
        200
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "dataPropertyName": "data",
        "extractionValues": {
          "values": [
            {
              "key": "title",
              "cssSelector": "title"
            },
            {
              "key": "description",
              "cssSelector": "meta[name=\"description\"]",
              "returnValue": "attribute",
              "attribute": "content"
            },
            {
              "key": "headings",
              "cssSelector": "h1, h2, h3",
              "returnArray": true
            },
            {
              "key": "body",
              "cssSelector": "body",
              "skipSelectors": "script, style, noscript, svg, iframe, form"
            }
          ]
        },
        "options": {
          "trimValues": true,
          "cleanUpText": true
        }
      },
      "id": "f8712df5-33cb-56d0-8f13-332f739300cf",
      "name": "Extract readable text",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        1100,
        200
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Company domain: {{ $('Work out the domain').item.json.domain }}\nPage title: {{ $json.title || 'n/a' }}\nMeta description: {{ $json.description || 'n/a' }}\nHeadings: {{ ($json.headings || []).slice(0, 25).join(' | ') }}\nHomepage text (trimmed):\n{{ String($json.body || '').slice(0, 6000) }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You research B2B leads for a sales team. From the homepage content provided, describe the company in plain words.\n\nRules:\n- Only use what the page says. If the page is empty, blocked or a parking page, say so in company_summary and use \"unknown\" elsewhere.\n- company_summary: one or two sentences on what they sell and to whom.\n- size_estimate: one of solo, small (2-10), medium (11-50), large (51-250), enterprise (250+), unknown.\n- size_signals: the concrete clues you used (locations, team page, \"trusted by\" logos, careers page, number of products). Short.\n- No hype, no guessing at revenue."
            }
          ]
        },
        "batching": {}
      },
      "id": "63c98275-0dc8-5027-b35b-892821acefc0",
      "name": "Summarize the company",
